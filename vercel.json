{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=dev",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://final-platform-eshro.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://final-platform-eshro.onrender.com/health"
    },
    {
      "source": "/((?!api/|assets/|help/|AdsForms/|favicon\\.ico|robots\\.txt|sitemap\\.xml|health).*)",
      "destination": "/index.html"
    }
  ],
  "regions": ["iad1"]
}
